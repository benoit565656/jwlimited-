# ===================================================
# Manila Wine Collector's Choice — Environment Config
# ===================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=https://jwlimited.manila-wine.com

# App Environment (development, test, production)
NODE_ENV=development

# ---------------------------------------------------
# Supabase Configuration
# (When left empty, the application runs on a complete,
# zero-setup local database repository for testing)
# ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------
# Authentication Providers
# (Configure in Supabase Dashboard or your OAuth console)
# ---------------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---------------------------------------------------
# Transactional Email (Resend Adapter)
# ---------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=collectors@manila-wine.com
EMAIL_FROM_NAME="Manila Wine Collector's Choice"

# ---------------------------------------------------
# Campaign Initial Secrets & Security
# ---------------------------------------------------
APP_SECRET=manila-wine-super-secret-key-change-in-production
ADMIN_DEFAULT_EMAIL=admin@manila-wine.com
ADMIN_INVITE_TOKEN=manila-wine-admin-preview-secret
